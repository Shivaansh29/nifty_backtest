# Optional settings for `docker compose` (M8). Copy this file to .env (which git ignores) and
# change what you need; every value shown is the default used when it is left out.

# Dashboard port on this computer. It is always bound to 127.0.0.1 (compose.yaml).
NIFTY_WEB_PORT=8080

# Folders on this computer that the API container mounts. Each must already exist.
# data/processed is mounted read-only, studies read-only, runs read-write.
NIFTY_DATA_DIR=./data
NIFTY_RUNS_DIR=./runs
NIFTY_STUDIES_DIR=./studies

# User and group the API runs as. On Linux, set these to your own (`id -u`, `id -g`) so the run
# folders it writes belong to you. Docker Desktop on macOS and Windows maps ownership itself.
NIFTY_UID=1000
NIFTY_GID=1000

# Time zone for run ids (local timestamps). Set it to this computer's if that is not India.
NIFTY_TZ=Asia/Kolkata

# GIT_COMMIT and GIT_DIRTY (the code version recorded in launched runs) change with every
# commit, so set them in the shell when building instead of here: see README, "Run with Docker".
